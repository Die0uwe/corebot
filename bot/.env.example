# Kopieer naar .env (die komt nooit in git). Waarden zonder aanhalingstekens.
DISCORD_TOKEN=
# Optioneel: de antwoordkanalen kies je in het paneel (Beheer > Discord-bot). Alleen invullen als je zonder paneel werkt.
DISCORD_CHANNEL_ID=
BOT_NAME=SB AI
TIMEZONE=Europe/Amsterdam

# Ollama: op dezelfde pc is dit meestal genoeg
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
# Alleen nodig als je via de Cloudflare-tunnel gaat:
OLLAMA_API_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Koppeling met het beheerpaneel (Beheer > Discord-bot): adres en geheim komen uit dat paneel.
# Nodig voor kanalen kiezen, instellingen, alarmen en Start/Stop via het paneel. Leeg = werkt alleen met .env.
SBWEBUI_PING_URL=
SBWEBUI_BOT_SECRET=

# Limieten
COOLDOWN_SECONDS=8
MAX_PER_HOUR=20
MAX_PARALLEL=2
MAX_INPUT_CHARS=1500
MEMORY_MESSAGES=6
